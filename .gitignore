# Paper data dumps and intermediate figure outputs are NEVER committed.
# Paper scripts under paper/paper_plots/scripts/ take explicit --data / --out
# flags; the user is responsible for supplying external storage for these.
/paper/paper_plots/dumps/
/paper/paper_plots/figures/
/analysis/

